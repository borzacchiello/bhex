struct Signature
{
    u8   b0;
    char png[3];
    u8   other[4];
}

struct RGB
{
    u8 r;
    u8 g;
    u8 b;
}

// The CRC of a chunk covers its type and its data, i.e. the `length + 4`
// bytes that end right before the crc field we have just read
fn check_crc(length)
{
    disable_print();
    local expected = crc("CRC-32/ISO-HDLC", length + 4, -(length + 8));
    result = expected;
}

// Generic PNG chunk
struct Chunk
{
    u32  length;
    char type[4];
    if (length > 0) {
        u8 data[length];
    }
    u32 crc;
    if (crc != check_crc(length)) {
        warning("chunk CRC mismatch");
    }
}

struct IHDRChunk
{
    u32  length;
    char type[4];
    u32  width;
    u32  height;
    u8   bit_depth;
    u8   color_type;
    u8   compression_method;
    u8   filter_method;
    u8   interlace_method;
    u32  crc;
    if (crc != check_crc(length)) {
        warning("chunk CRC mismatch");
    }
}

struct PLTEChunk
{
    u32  length;
    char type[4];
    RGB  entries[length / 3];
    u32  crc;
    if (crc != check_crc(length)) {
        warning("chunk CRC mismatch");
    }
}

struct IDATChunk
{
    u32  length;
    char type[4];
    u8   compressed_data[length];
    u32  crc;
    if (crc != check_crc(length)) {
        warning("chunk CRC mismatch");
    }
}

struct IENDChunk
{
    u32  length;
    char type[4];
    u32  crc;
    if (crc != check_crc(length)) {
        warning("chunk CRC mismatch");
    }
}


// The 8 byte signature is what "_identify" starts by checking, so nothing it
// accepts can be missing it
proc _identify_magic
{
    magic("\x89PNG\r\n\x1a\n", 0);
}

// The 8 byte signature, plus the IHDR chunk the spec requires to come first.
// The signature is re-checked here rather than assumed: the declaration above
// only says where it is worth asking, never what the answer is
proc _identify
{
    big_endian();
    if (peek_u32() != 0x89504e47 || peek_u32(4) != 0x0d0a1a0a ||
        peek(4, 12) != "IHDR") {
        return;
    }

    // The chunk list is a linked walk, so the end of the image is a handful of
    // additions away: report it, and the scan resumes past the whole PNG
    local o = 8;
    while (o + 8 <= remaining_size()) {
        local len = peek_u32(o);
        if (len > remaining_size() - o - 12) {
            break;
        }
        local type = peek(4, o + 4);
        o = o + 12 + len;
        if (type == "IEND") {
            result = o;
            return;
        }
    }

    // truncated, or a chunk length that does not add up: fall back to the
    // signature and the IHDR chunk, the bytes actually validated
    result = 33;
}

proc
{
    big_endian();

    Signature signature;
    while (off() < size()) {
        // the chunk type is the 4 bytes that follow the length
        local type = peek(4, 4);
        if (type == "IHDR") {
            IHDRChunk ihdr;
        } elif (type == "PLTE") {
            PLTEChunk plte;
        } elif (type == "IDAT") {
            IDATChunk idat;
        } elif (type == "IEND") {
            IENDChunk iend;
        } else {
            Chunk chunk;
        }
    }
}
