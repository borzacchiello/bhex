struct Signature
{
    u8   b0;
    char png[3];
    u8   other[4];
}

struct RGB
{
    u8 r;
    u8 g;
    u8 b;
}

// The CRC of a chunk covers its type and its data, i.e. the `length + 4`
// bytes that end right before the crc field we have just read
fn check_crc(length)
{
    disable_print();
    local expected = crc("CRC-32/ISO-HDLC", length + 4, -(length + 8));
    result = expected;
}

// Generic PNG chunk
struct Chunk
{
    u32  length;
    char type[4];
    if (length > 0) {
        u8 data[length];
    }
    u32 crc;
    if (crc != check_crc(length)) {
        warning("chunk CRC mismatch");
    }
}

struct IHDRChunk
{
    u32  length;
    char type[4];
    u32  width;
    u32  height;
    u8   bit_depth;
    u8   color_type;
    u8   compression_method;
    u8   filter_method;
    u8   interlace_method;
    u32  crc;
    if (crc != check_crc(length)) {
        warning("chunk CRC mismatch");
    }
}

struct PLTEChunk
{
    u32  length;
    char type[4];
    RGB  entries[length / 3];
    u32  crc;
    if (crc != check_crc(length)) {
        warning("chunk CRC mismatch");
    }
}

struct IDATChunk
{
    u32  length;
    char type[4];
    u8   compressed_data[length];
    u32  crc;
    if (crc != check_crc(length)) {
        warning("chunk CRC mismatch");
    }
}

struct IENDChunk
{
    u32  length;
    char type[4];
    u32  crc;
    if (crc != check_crc(length)) {
        warning("chunk CRC mismatch");
    }
}

proc
{
    big_endian();

    Signature signature;
    while (off() < size()) {
        // the chunk type is the 4 bytes that follow the length
        local type = peek(4, 4);
        if (type == "IHDR") {
            IHDRChunk ihdr;
        } elif (type == "PLTE") {
            PLTEChunk plte;
        } elif (type == "IDAT") {
            IDATChunk idat;
        } elif (type == "IEND") {
            IENDChunk iend;
        } else {
            Chunk chunk;
        }
    }
}
