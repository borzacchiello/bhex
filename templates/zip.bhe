enum ExtraFieldType : u16
{
    EXTRA_FIELD_ZIP64                   = 0x0001, // ZIP64 extended information
    EXTRA_FIELD_AV_INFO                 = 0x0007, // AV Info
    EXTRA_FIELD_NTFS                    = 0x000a, // NTFS file attributes
    EXTRA_FIELD_UNIX                    = 0x000d, // UNIX file attributes
    EXTRA_FIELD_UNIX_NEW                = 0x7875, // Info-ZIP New Unix (newer UID/GID)
    EXTRA_FIELD_STRONG_ENCRYPTION       = 0x0017, // Strong encryption header
    EXTRA_FIELD_PATCH_DESCRIPTOR        = 0x000f, // Patch descriptor
    EXTRA_FIELD_PKCS7                   = 0x0014, // PKCS#7 Store for X.509 Certificates
    EXTRA_FIELD_X509_CERT_ID_SIG        = 0x0015, // X.509 Certificate ID and Signature
    EXTRA_FIELD_X509_CERT_ID            = 0x0016, // X.509 Certificate ID
    EXTRA_FIELD_POLICY_DECRYPTION_KEY   = 0x0019, // Policy Decryption Key Record
    EXTRA_FIELD_SMARTCRYPT_KEY_PROVIDER = 0x001a, // Smartcrypt Key Provider Record
    EXTRA_FIELD_SMARTCRYPT_POLICY_KEY   = 0x001b, // Smartcrypt Policy Key Data Record
    EXTRA_FIELD_MVS                     = 0x0065, // MVS Extra Field
    EXTRA_FIELD_OS2_EXTENDED_ATTRIBUTES = 0x0009, // OS/2 Extended Attributes
    EXTRA_FIELD_ASI_UNIX                = 0x756e, // ASi Unix Extra Field
    EXTRA_FIELD_EXTENDED_TIMESTAMP      = 0x5455, // Extended Timestamp
    EXTRA_FIELD_UNICODE_PATH            = 0x7075, // Info-ZIP Unicode Path
    EXTRA_FIELD_UNICODE_COMMENT         = 0x6375, // Info-ZIP Unicode Comment
    EXTRA_FIELD_AES_ENCRYPTION          = 0x9901, // WinZip AES Encryption
    EXTRA_FIELD_XCEED_UNICODE           = 0x554e, // Xceed Unicode Extra Field
    EXTRA_FIELD_JAVA_ATTRIBUTES         = 0xcafe  // Java JAR file attributes
}

struct EXTRA_FIELD_EXTENDED_TIMESTAMP
{
    u16 data_size;  // Size of the data portion
    u8  flags;      // Bit 0: mtime, Bit 1: atime, Bit 2: ctime

    // Followed by timestamps in Unix format (uint32_t each):
    local i = 0;
    while ( i < data_size - 1 ) {
        u32 time;
        i = i + 4;
    }
}

struct UNIX_NEW_UID
{
    u8 size; // Size of UID field (1, 2, 4, or 8 bytes)
    if (size == 1) {
        u8 value;
    } elif (size == 2) {
        u16 value;
    } elif (size == 4) {
        u32 value;
    } elif (size == 8) {
        u64 value;
    } else {
        u8 value[size];
    }
}

struct EXTRA_FIELD_UNIX_NEW
{
    u16          data_size;  // Total data size for this block
    u8           version;    // Version (currently 1)
    UNIX_NEW_UID uid;
    UNIX_NEW_UID gid;
}

struct ExtraFieldHeader
{
    ExtraFieldType header_id; // Identifies the extra field type

    // data_size bytes of field-specific data
    if (header_id == ExtraFieldType::EXTRA_FIELD_EXTENDED_TIMESTAMP) {
        EXTRA_FIELD_EXTENDED_TIMESTAMP ext_timestamp;
    } elif (header_id == ExtraFieldType::EXTRA_FIELD_UNIX_NEW) {
        EXTRA_FIELD_UNIX_NEW unix_new;
    } else {
        u16 data_size;
        u8  data[data_size];
    }
}

fn parse_extra_fields(len)
{
    local prev = off();
    while (len > 0) {
        ExtraFieldHeader extraField;
        local            adv = off() - prev;
        len  = len - adv;
        prev = off();
    }
}

orenum HeaderFlag : u16
{
    ENCRYPTED_FILE          = 1,
    COMPRESSION_OPTION_1    = 2,
    COMPRESSION_OPTION_2    = 4,
    DATA_DESCRIPTOR         = 8,
    ENHANCED_DEFLATION      = 16,
    COMPRESSED_PATCHED_DATA = 32,
    STRONG_ENCRYPTION       = 64,
    LANGUAGE_ENCODING       = 2048,
    MASK_HEADER_VALUES      = 8192
}

enum CompressionMethod : u16
{
    NO_COMPRESSION                    = 0,
    SHRUNK                            = 1,
    REDUCED_WITH_COMPRESSION_FACTOR_1 = 2,
    REDUCED_WITH_COMPRESSION_FACTOR_2 = 3,
    REDUCED_WITH_COMPRESSION_FACTOR_3 = 4,
    REDUCED_WITH_COMPRESSION_FACTOR_4 = 5,
    IMPLODED                          = 6,
    DEFLATED                          = 8,
    ENHANCED_DEFLATED                 = 9,
    PKWARE_DCL_IMPLODED               = 10,
    BZIP2                             = 12,
    LZMA                              = 14,
    IBM_TERSE                         = 18,
    IBM_LZ77z                         = 19,
    PPMd_version_1_rev_1              = 98
}

struct LocalFileHeader
{
    u8                signature[4];
    u16               version;
    HeaderFlag        flags;
    CompressionMethod compression;
    u16               mod_time;
    u16               mod_date;
    u32               crc32;
    u32               compressed_size;
    u32               uncompressed_size;
    u16               filename_len;
    u16               extra_field_len;
    char              filename[filename_len];

    parse_extra_fields(extra_field_len);
}

struct CentralDirectoryHeader
{
    char              signature[4];         // 0x02014b50 (PK\001\002)
    u16               version_made_by;      // Version made by
    u16               version_needed;       // Version needed to extract
    HeaderFlag        flags;                // General purpose bit flag
    CompressionMethod compression_method;   // Compression method
    u16               mod_time;             // Last mod file time
    u16               mod_date;             // Last mod file date
    u32               crc32;                // CRC-32 checksum
    u32               compressed_size;      // Compressed size
    u32               uncompressed_size;    // Uncompressed size
    u16               filename_length;      // Filename length
    u16               extra_field_length;   // Extra field length
    u16               comment_length;       // File comment length
    u16               disk_number;          // Disk number start
    u16               internal_attributes;  // Internal file attributes
    u32               external_attributes;  // External file attributes
    u32               local_header_offset;  // Relative offset of local header

    char filename[filename_length];
    parse_extra_fields(extra_field_length);
    if (comment_length > 0) {
        u8 comment[comment_length];
    }
}

struct EndOfCentralDirZIP
{
    char signature[4];           // 0x06054b50 (PK\005\006)
    u16  disk_number;            // Number of this disk
    u16  central_dir_disk;       // Disk where central directory starts
    u16  central_dir_entries;    // Number of central directory entries on this disk
    u16  total_entries;          // Total number of central directory entries
    u32  central_dir_size;       // Size of central directory
    u32  central_dir_offset;     // Offset of start of central directory
    u16  comment_length;         // ZIP file comment length
    if (comment_length > 0) {
        char comment[comment_length];
    }
}

struct EndOfCentralDirZIP64
{
    char signature[4];           // 0x06064b50 (PK\006\006)
    u64  record_size;            // Size of ZIP64 end of central directory record
    u16  version_made_by;        // Version made by
    u16  version_needed;         // Version needed to extract
    u32  disk_number;            // Number of this disk
    u32  central_dir_disk;       // Disk where central directory starts
    u64  central_dir_entries;    // Number of central directory entries on this disk
    u64  total_entries;          // Total number of central directory entries
    u64  central_dir_size;       // Size of central directory
    u64  central_dir_offset;     // Offset of start of central directory
    // Followed by:
    // - ZIP64 extensible data sector (variable length)
}

fn newline()
{
    print("");
}

fn seek_to_central_dir()
{
    local magic   = "PK\x05\x06";
    local magic64 = "PK\x06\x06";

    // seek to end
    seek(size());
    if (find(magic, 1 /* backward search */ )) {
        // ZIP
        EndOfCentralDirZIP endOfCentralDir;
        seek(endOfCentralDir.central_dir_offset);
        result = endOfCentralDir;
    } elif (find(magic64, 1 /* backward search */ )) {
        // ZIP64
        print("[!] ZIP64 is poorly supported");
        EndOfCentralDirZIP64 endOfCentralDir;
        seek(endOfCentralDir.central_dir_offset);
        result = endOfCentralDir;
    } else {
        error("invalid ZIP");
    }
}

proc list_files
{
    local endOfCentralDir = seek_to_central_dir();

    local i = 0;
    while ( i < endOfCentralDir.central_dir_entries ) {
        CentralDirectoryHeader dirElement;
        print(dirElement.filename, "[", dirElement.uncompressed_size, "bytes ]");
        i = i + 1;
    }
}


// The local file header signature
proc _identify_magic
{
    magic("PK\x03\x04", 0);
}

// The compressed size out of the zip64 extended information extra field, which
// is where it lives once the 32 bit field is saturated. The field only carries
// the sizes whose 32 bit counterpart is saturated, in a fixed order, so the
// uncompressed one being there is what decides the offset of this one
fn zip64_csize(at, nl, el, usize_saturated)
{
    local p     = at + 30 + nl;
    local stop  = p + el;
    local fsize = size();
    local id    = 0;
    local len   = 0;
    local field = 0;
    while (p + 4 <= stop && p + 4 <= fsize) {
        seek(p);
        id  = peek_u16();
        len = peek_u16(2);
        if (id == 1) {
            field = p + 4;
            if (usize_saturated) {
                field = field + 8;
            }
            if (field + 8 <= stop && field + 8 <= fsize) {
                seek(field);
                result = peek_u64();
            }
            return;
        }
        p = p + 4 + len;
    }
}

// Everything past a local file header's fixed part: the two variable length
// fields and the payload. Zero when the header does not know, which is the
// case for an entry written as a stream -- the sizes then live in a data
// descriptor behind the payload, and only the central directory has them
fn local_entry_size(at)
{
    if (at + 30 > size()) {
        return;
    }
    seek(at);
    if (peek_u32() != 0x04034b50) {
        return;
    }

    local flags = peek_u16(6);
    local csize = peek_u32(18);
    local usize = peek_u32(22);
    local nl    = peek_u16(26);
    local el    = peek_u16(28);

    if (csize == 0xffffffff) {
        csize = zip64_csize(at, nl, el, usize == 0xffffffff);
        if (csize == 0) {
            return;
        }
    }
    if (csize == 0 && (flags & 8) != 0) {
        return;
    }
    result = 30 + nl + el + csize;
}

// An entry written as a stream does not know its own length: the sizes follow
// the payload in a data descriptor, and only where the entry ends says where
// that is. The next signature in the file is the only candidate, and the size
// the descriptor in front of it reports is what confirms it -- compressed data
// is full of bytes that look like a signature, and this is what tells them
// apart. Returns the offset just past the entry, or 0
fn streamed_entry_end(payload_start)
{
    local fsize = size();
    local from  = payload_start;
    local tries = 0;
    local a     = 0;
    local b     = 0;
    local c     = 0;
    while (tries < 32 && from + 4 <= fsize) {
        // whichever of the two signatures that may follow an entry comes first
        seek(from);
        a = find_next("PK\x03\x04");
        seek(from);
        b = find_next("PK\x01\x02");
        c = a;
        if (a < 0 || (b >= 0 && b < a)) {
            c = b;
        }
        if (c < 0) {
            return;
        }

        // the descriptor, with or without its optional signature, and in the
        // 32 or the 64 bit shape
        if (c >= payload_start + 16) {
            seek(c - 16);
            if (peek_u32() == 0x08074b50 &&
                peek_u32(8) == c - 16 - payload_start) {
                result = c;
                return;
            }
        }
        if (c >= payload_start + 24) {
            seek(c - 24);
            if (peek_u32() == 0x08074b50 &&
                peek_u64(8) == c - 24 - payload_start) {
                result = c;
                return;
            }
        }
        if (c >= payload_start + 12) {
            seek(c - 12);
            if (peek_u32(4) == c - 12 - payload_start) {
                result = c;
                return;
            }
        }
        if (c >= payload_start + 20) {
            seek(c - 20);
            if (peek_u64(4) == c - 20 - payload_start) {
                result = c;
                return;
            }
        }

        from  = c + 4;
        tries = tries + 1;
    }
}

// Walks the local file headers from `at` to the central directory, which is
// where they stop. Returns its offset, or 0 if the walk never gets there
fn walk_local_headers(at)
{
    local fsize = size();
    local d     = 0;
    local ok    = 0;
    while (at + 30 <= fsize) {
        seek(at);
        if (peek_u32() == 0x02014b50) {
            result = at;
            return;
        }

        local streamed = (peek_u16(6) & 8) != 0;
        local adv      = local_entry_size(at);
        if (adv == 0) {
            // the header does not carry the sizes at all, so where the entry
            // ends has to be recovered from the descriptor behind it
            if (streamed == 0) {
                return;
            }
            seek(at);
            at = streamed_entry_end(at + 30 + peek_u16(26) + peek_u16(28));
            if (at == 0) {
                return;
            }
            continue;
        }
        at = at + adv;

        // an entry with a trailing data descriptor: it is 12 or 16 bytes (24
        // or 28 for zip64), and only what follows it says which. Landing on
        // the next signature is the confirmation that the guess was right
        if (streamed) {
            d  = 0;
            ok = 0;
            while (d <= 28) {
                if (at + d + 4 <= fsize) {
                    seek(at + d);
                    if (peek_u32() == 0x04034b50 || peek_u32() == 0x02014b50) {
                        at = at + d;
                        ok = 1;
                        break;
                    }
                }
                d = d + 4;
            }
            if (ok == 0) {
                return;
            }
        }
    }
}

// Walks the central directory headers from `at` to whatever follows them
fn walk_central_dir(at)
{
    local fsize = size();
    while (at + 46 <= fsize) {
        seek(at);
        if (peek_u32() != 0x02014b50) {
            break;
        }
        at = at + 46 + peek_u16(28) + peek_u16(30) + peek_u16(32);
    }
    result = at;
}

// The size of the archive that starts at `at`, or 0. Walking the entries and
// the directory only gets as far as the end of central directory record; what
// makes the answer trustworthy is the record itself, which says where the
// archive it belongs to begins. An entry in the middle of an archive walks to
// the same record, and that is what tells the two apart
fn archive_size(at)
{
    local fsize = size();

    local cur = walk_local_headers(at);
    if (cur == 0) {
        return;
    }
    cur = walk_central_dir(cur);

    // a zip64 archive puts its own record, and a locator for it, in front of
    // the one every archive ends with, and saturates the fields it replaces
    local cd_size  = 0;
    local cd_off   = 0;
    local is_zip64 = 0;
    if (cur + 56 <= fsize) {
        seek(cur);
        if (peek_u32() == 0x06064b50) {
            cd_size  = peek_u64(40);
            cd_off   = peek_u64(48);
            is_zip64 = 1;
            cur      = cur + 12 + peek_u64(4); // the record sizes itself
        }
    }
    if (cur + 20 <= fsize) {
        seek(cur);
        if (peek_u32() == 0x07064b50) {
            cur = cur + 20;
        }
    }

    if (cur + 22 > fsize) {
        return;
    }
    seek(cur);
    if (peek_u32() != 0x06054b50) {
        return;
    }
    if (is_zip64 == 0) {
        cd_size = peek_u32(12);
        cd_off  = peek_u32(16);
    }

    // both are relative to the start of the archive, and the record sits just
    // past the directory: subtracting them is where the archive began
    local end = cur + 22 + peek_u16(20);
    if (end > fsize || cd_size + cd_off > cur) {
        return;
    }
    if (cur - cd_size - cd_off == at) {
        result = end - at;
    }
}

// A local file header, which is what a zip (and every zip-derived container:
// jar, apk, docx, epub) starts with. The signature is backed by two fields
// that cannot hold arbitrary values: the version needed to extract, and a
// compression method from the assigned range.
//
// That is only the entry point: an archive is a run of such headers, so
// stopping there would report one hit per file inside it. The whole thing is
// walked instead, and reported once, at the offset it starts at
proc _identify
{
    little_endian();
    if (peek_u32() != 0x04034b50 || peek_u16(4) > 63 || peek_u16(8) > 99) {
        return;
    }

    local start = off();
    result      = archive_size(start);

    // Nothing behind this header adds up to a whole archive: it is an entry in
    // the middle of one, or what is left of a truncated one. The header itself
    // is well formed, so that much is still reported
    if (result == 0) {
        result = local_entry_size(start);
        if (result == 0 || start + result > size()) {
            seek(start);
            result = min(30 + peek_u16(26) + peek_u16(28), remaining_size());
        }
    }
    seek(start);
}

proc
{
    local endOfCentralDir = seek_to_central_dir();

    local i = 0;
    while ( i < endOfCentralDir.central_dir_entries ) {
        newline();
        CentralDirectoryHeader dirElement;

        local off = off();
        seek(dirElement.local_header_offset);
        LocalFileHeader localElement;
        if (dirElement.compressed_size > 0) {
            u8 data[dirElement.compressed_size];

            // a stored entry is its own uncompressed data, so the CRC in the
            // header covers exactly the bytes we have just read
            if (localElement.compression == CompressionMethod::NO_COMPRESSION) {
                local actual = crc("CRC-32/ISO-HDLC",
                                   dirElement.compressed_size,
                                   -dirElement.compressed_size);
                if (localElement.crc32 != actual) {
                    warning("CRC mismatch for", localElement.filename);
                }
            }
        }
        seek(off);
        i = i + 1;
    }

    assert(off() - endOfCentralDir.central_dir_offset ==
           endOfCentralDir.central_dir_size,
           "invalid central_dir_size");
}
