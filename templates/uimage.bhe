// The legacy U-Boot image format: a fixed 64 byte big endian header followed
// by the payload it describes. Everything in the header is big endian, whatever
// the target is.

enum uimage_os_t : u8
{
    INVALID          = 0,
    OPENBSD          = 1,
    NETBSD           = 2,
    FREEBSD          = 3,
    BSD_4_4          = 4,
    LINUX            = 5,
    SVR4             = 6,
    ESIX             = 7,
    SOLARIS          = 8,
    IRIX             = 9,
    SCO              = 10,
    DELL             = 11,
    NCR              = 12,
    LYNXOS           = 13,
    VXWORKS          = 14,
    PSOS             = 15,
    QNX              = 16,
    U_BOOT           = 17,
    RTEMS            = 18,
    ARTOS            = 19,
    UNITY            = 20,
    INTEGRITY        = 21,
    OSE              = 22,
    PLAN9            = 23,
    OPENRTOS         = 24,
    ARM_TRUSTED_FW   = 25,
    TEE              = 26,
    OPENSBI          = 27,
    EFI              = 28,
    ELF              = 29
}

enum uimage_arch_t : u8
{
    INVALID     = 0,
    ALPHA       = 1,
    ARM         = 2,
    I386        = 3,
    IA64        = 4,
    MIPS        = 5,
    MIPS64      = 6,
    PPC         = 7,
    S390        = 8,
    SH          = 9,
    SPARC       = 10,
    SPARC64     = 11,
    M68K        = 12,
    NIOS        = 13,
    MICROBLAZE  = 14,
    NIOS2       = 15,
    BLACKFIN    = 16,
    AVR32       = 17,
    ST200       = 18,
    SANDBOX     = 19,
    NDS32       = 20,
    OPENRISC    = 21,
    ARM64       = 22,
    ARC         = 23,
    X86_64      = 24,
    XTENSA      = 25,
    RISCV       = 26
}

enum uimage_type_t : u8
{
    INVALID       = 0,
    STANDALONE    = 1,
    KERNEL        = 2,
    RAMDISK       = 3,
    MULTI         = 4,
    FIRMWARE      = 5,
    SCRIPT        = 6,
    FILESYSTEM    = 7,
    FLAT_DT       = 8,
    KWBIMAGE      = 9,
    IMXIMAGE      = 10,
    UBLIMAGE      = 11,
    OMAPIMAGE     = 12,
    AISIMAGE      = 13,
    KERNEL_NOLOAD = 14,
    PBLIMAGE      = 15,
    MXSIMAGE      = 16,
    GPIMAGE       = 17,
    ATMELIMAGE    = 18,
    SOCFPGAIMAGE  = 19,
    X86_SETUP     = 20,
    LPC32XXIMAGE  = 21,
    LOADABLE      = 22,
    RKIMAGE       = 23,
    RKSD          = 24,
    RKSPI         = 25,
    ZYNQIMAGE     = 26,
    ZYNQMPIMAGE   = 27,
    ZYNQMPBIF     = 28,
    FPGA          = 29,
    VYBRIDIMAGE   = 30,
    TEE           = 31,
    FIRMWARE_IVT  = 32,
    PMMC          = 33,
    STM32IMAGE    = 34,
    MTKIMAGE      = 37,
    IMX8MIMAGE    = 38,
    IMX8IMAGE     = 39,
    COPRO         = 40,
    SUNXI_EGON    = 41,
    SUNXI_TOC0    = 42,
    FDT_LEGACY    = 43,
    RENESAS_SPKG  = 44
}

enum uimage_comp_t : u8
{
    NONE  = 0,
    GZIP  = 1,
    BZIP2 = 2,
    LZMA  = 3,
    LZO   = 4,
    LZ4   = 5,
    ZSTD  = 6
}

// The 64 byte header. `hcrc` covers the header itself with the `hcrc` field
// zeroed, which cannot be expressed against bytes on disk, so `dcrc` is the
// one this template verifies: it covers the payload, which is contiguous.
struct uimage_header_t
{
    big_endian();

    u32            magic;
    u32            hcrc;
    u32            timestamp;
    u32            data_size;
    u32            load_address;
    u32            entry_point;
    u32            dcrc;
    uimage_os_t    os;
    uimage_arch_t  arch;
    uimage_type_t  type;
    uimage_comp_t  compression;
    char           name[32];

    assert(magic == 0x27051956, "not a uImage: bad magic");
    assert(data_size <= remaining_size(), "truncated uImage: data_size runs past the end of the file");

    if (dcrc != crc("CRC-32/ISO-HDLC", data_size, 0)) {
        warning("payload CRC mismatch");
    }
}

// A "multi" image carries several payloads: a NUL terminated table of big
// endian sizes, then the images themselves, each padded to a 4 byte boundary.
struct uimage_multi_t
{
    big_endian();

    local table = off();
    local count = 0;
    while (off() + count * 4 + 4 <= size() && peek_u32(count * 4) != 0) {
        count = count + 1;
    }
    assert(off() + count * 4 + 4 <= size(), "malformed multi image: unterminated size table");

    u32 image_sizes[count];
    u32 terminator;

    // The sizes have to be read back out of the table to declare the images,
    // so the cursor bounces between the table and the payload
    local at = off();
    local i  = 0;
    while (i < count) {
        seek(table + i * 4);
        local image_size = peek_u32();

        seek(at);
        assert(image_size <= remaining_size(), "malformed multi image: image runs past the end of the file");
        u8 image[image_size];

        at = at + align_up(image_size, 4);
        i  = i + 1;
    }
    seek(at);
}

proc _identify_magic
{
    magic("\x27\x05\x19\x56", 0);
}

// The magic is four bytes, which on its own turns up inside any compressed
// payload, so the four one byte fields behind it are range checked and the
// payload CRC the header carries is verified. A header whose CRC checks out
// gives the exact extent of the image; one that only passes the field checks
// is reported as a header, since a truncated image is still worth seeing.
proc _identify
{
    big_endian();
    if (peek_u32() != 0x27051956) {
        return;
    }

    local data_size = peek_u32(12);
    local os        = peek_u8(28);
    local arch      = peek_u8(29);
    local type      = peek_u8(30);
    local comp      = peek_u8(31);

    if (os == 0 || os > 29 || arch == 0 || arch > 26 ||
        type == 0 || type > 44 || comp > 6) {
        return;
    }

    result = min(64, remaining_size());
    if (data_size > 0 && remaining_size() >= 64 && data_size <= remaining_size() - 64 &&
        peek_u32(24) == crc("CRC-32/ISO-HDLC", data_size, 64)) {
        result = 64 + data_size;
    }
}

proc
{
    uimage_header_t header;

    if (header.type == uimage_type_t::MULTI) {
        uimage_multi_t multi;
    } else {
        u8 payload[header.data_size];
    }
}
