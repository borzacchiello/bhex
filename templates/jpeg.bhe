enum JPEG_Marker : u16
{
    TEM          = 0xff01,
    SOF0         = 0xffc0,
    SOF1         = 0xffc1,
    SOF2         = 0xffc2,
    SOF3         = 0xffc3,
    DHT          = 0xffc4,
    SOF5         = 0xffc5,
    SOF6         = 0xffc6,
    SOF7         = 0xffc7,
    JPG_RESERVED = 0xffc8,
    SOF9         = 0xffc9,
    SOF10        = 0xffca,
    SOF11        = 0xffcb,
    DAC          = 0xffcc,
    SOF13        = 0xffcd,
    SOF14        = 0xffce,
    SOF15        = 0xffcf,
    RST0         = 0xffd0,
    RST1         = 0xffd1,
    RST2         = 0xffd2,
    RST3         = 0xffd3,
    RST4         = 0xffd4,
    RST5         = 0xffd5,
    RST6         = 0xffd6,
    RST7         = 0xffd7,
    SOI          = 0xffd8,
    EOI          = 0xffd9,
    SOS          = 0xffda,
    DQT          = 0xffdb,
    DNL          = 0xffdc,
    DRI          = 0xffdd,
    DHP          = 0xffde,
    EXP          = 0xffdf,
    APP0         = 0xffe0,
    APP1         = 0xffe1,
    APP2         = 0xffe2,
    APP3         = 0xffe3,
    APP4         = 0xffe4,
    APP5         = 0xffe5,
    APP6         = 0xffe6,
    APP7         = 0xffe7,
    APP8         = 0xffe8,
    APP9         = 0xffe9,
    APP10        = 0xffea,
    APP11        = 0xffeb,
    APP12        = 0xffec,
    APP13        = 0xffed,
    APP14        = 0xffee,
    APP15        = 0xffef,
    VER          = 0xfff0,
    DTI          = 0xfff1,
    DTT          = 0xfff2,
    SRF          = 0xfff3,
    SRS          = 0xfff4,
    DCR          = 0xfff5,
    DQS          = 0xfff6,
    JPG0         = 0xfff7,
    JPG1         = 0xfff8,
    JPG2         = 0xfff9,
    JPG3         = 0xfffa,
    JPG4         = 0xfffb,
    JPG5         = 0xfffc,
    JPG6         = 0xfffd,
    COM          = 0xfffe
}

struct unsized_marker_t
{
    JPEG_Marker id;
}

struct sized_marker_t
{
    JPEG_Marker id;
    u16         size;

    assert(size >= 2, "malformed JPEG segment: length field is below its own size");
    assert(size - 2 <= remaining_size(), "malformed JPEG segment: runs past the end of the file");
    u8          data[size - 2];
}

struct pixel_t
{
    u8 R;
    u8 G;
    u8 B;
}

struct APP0
{
    JPEG_Marker id;
    u16         size;
    char        identifier[5];
    u16         JFIF_version;
    u8          density_units;
    u16         x_density;
    u16         y_density;
    u8          x_thumbnail;
    u8          y_thumbnail;
    // both are u8, and their product truncates to u8 unless widened: a
    // 16x16 thumbnail would otherwise come out as no thumbnail at all
    if (u64(x_thumbnail) * y_thumbnail > 0) {
        pixel_t thumbnail_data[u64(x_thumbnail) * y_thumbnail];
    }
}

struct sos_component_t
{
    u8 selector;
    u8 huffman;
}

struct SOS
{
    JPEG_Marker     id;
    u16             size;
    u8              ns;
    sos_component_t components[ns];
    u8              ss;
    u8              se;
    u8              ah_al;
}

fn is_zero_len_marker(id)
{
    result = 0;
    if (id == JPEG_Marker::TEM) {
        result = 1;
    } elif (id >= JPEG_Marker::RST0 && id <= JPEG_Marker::RST7) {
        result = 1;
    } elif (id == JPEG_Marker::SOI) {
        result = 1;
    } elif (id == JPEG_Marker::EOI) {
        result = 1;
    }
}

fn calc_SOS_size()
{
    // https://stackoverflow.com/questions/26715684/parsing-jpeg-sos-marker
    // the scan ends at the first 0xff that is not a stuffed byte (0xff 0x00)
    // nor a restart marker (0xff 0xd0 - 0xff 0xd7)

    disable_print();

    local begin = off();
    while (1) {
        local marker = find_next("\xff");
        assert(marker >= 0, "invalid SOS chunk");

        local next = peek_u8(marker + 1 - off());
        if (next != 0 && !(next >= 0xd0 && next <= 0xd7)) {
            result = marker - begin;
            break;
        }
        seek(marker + 2);
    }

    seek(begin);
}

fn parse_chunk()
{
    local id = peek_u16();

    if (id == JPEG_Marker::APP0) {
        APP0 app0_chunk;
    } elif (id == JPEG_Marker::SOS) {
        SOS sos_header;
        local sos_size = calc_SOS_size();
        u8 sos_data[sos_size];
    } elif (is_zero_len_marker(id)) {
        unsized_marker_t chunk;
    } else {
        sized_marker_t chunk;
    }
}


// SOI plus the 0xff that has to open the marker behind it. Not the full four
// bytes: "_identify" accepts any of ~35 markers there, so pinning the fourth
// byte would make this stop being a necessary condition and hide files
proc _identify_magic
{
    magic("\xff\xd8\xff", 0);
}

// SOI, then a marker that can legally open a file, then a second well formed
// segment behind it. 'ff d8' on its own turns up inside any entropy-coded
// payload and all over m68k firmware, where 0xffd8 is an ordinary negative
// displacement; chaining two segments is what tells those apart
proc _identify
{
    big_endian();
    if (peek_u16() != 0xffd8 || peek_u8(2) != 0xff || remaining_size() < 6) {
        return;
    }

    // Every one of these carries a length: SOFn and DHT (0xc0-0xcf), DQT, DRI,
    // APPn and COM. RSTn, SOI and EOI carry nothing, and SOS cannot come first
    // because the tables it uses have to be declared before it
    local m  = peek_u8(3);
    local ok = (m >= 0xc0 && m <= 0xcf) || m == 0xdb || m == 0xdd ||
               (m >= 0xe0 && m <= 0xef) || m == 0xfe;
    if (!ok) {
        return;
    }

    local len = peek_u16(4);
    if (len < 2 || 4 + len + 2 > remaining_size()) {
        return;
    }

    // whatever follows that segment has to be a marker as well
    if (peek_u8(4 + len) != 0xff) {
        return;
    }
    local m2 = peek_u8(5 + len);
    if (m2 == 0x00 || m2 == 0xff || m2 == 0xd8) {
        return;
    }

    // finding the EOI means walking the entropy-coded segments, which is the
    // parse itself: the hit covers the header validated here
    result = 4 + len;
}

proc
{
    nums_in(10);
    big_endian();

    while (off() < size()) {
        parse_chunk();
    }
}
