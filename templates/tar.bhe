struct TarHeader
{
    char name[100];
    char mode[8];
    char uid[8];
    char gid[8];
    char size[12];
    char mtime[12];
    char chksum[8];
    char typeflag;
    char linkname[100];
    char magic[6];
    char version[2];
    char uname[32];
    char gname[32];
    char devmajor[8];
    char devminor[8];
    char prefix[155];
    u8   padding[12];
}

// the numeric fields of a tar header are octal ASCII, hence the explicit base
proc list_files
{
    while (off() + 0x200 < size()) {
        TarHeader header;
        if (strlen(header.size) == 0) {
            break;
        }
        print(header.name, "[", to_int(printable(header.size), 8), "bytes ]");
        u8    data[to_int(printable(header.size), 8)];
        // every entry is padded to the 512 bytes block size
        seek(align_up(off(), 0x200));
    }
}

proc
{
    while (off() + 0x200 < size()) {
        TarHeader header;
        if (strlen(header.size) == 0) {
            break;
        }
        u8    data[to_int(printable(header.size), 8)];
        // every entry is padded to the 512 bytes block size
        seek(align_up(off(), 0x200));
    }
}
