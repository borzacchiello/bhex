struct TarHeader
{
    char name[100];
    char mode[8];
    char uid[8];
    char gid[8];
    char size[12];
    char mtime[12];
    char chksum[8];
    char typeflag;
    char linkname[100];
    char magic[6];
    char version[2];
    char uname[32];
    char gname[32];
    char devmajor[8];
    char devminor[8];
    char prefix[155];
    u8   padding[12];
}

// the numeric fields of a tar header are octal ASCII, hence the explicit base
proc list_files
{
    while (off() + 0x200 < size()) {
        TarHeader header;
        if (strlen(header.size) == 0) {
            break;
        }
        print(header.name, "[", to_int(printable(header.size), 8), "bytes ]");
        u8    data[to_int(printable(header.size), 8)];
        // every entry is padded to the 512 bytes block size
        seek(align_up(off(), 0x200));
    }
}

// The checksum a header block carries over itself: the sum of all 512 of its
// bytes, with the 8 byte checksum field counted as spaces rather than as its
// own content. Unsigned, which is what every writer since the historical
// signed-char implementations produces
fn header_checksum()
{
    disable_print();
    result = checksum("SUM-32", 148, 0) + 8 * 0x20 +
             checksum("SUM-32", 0x200 - 156, 156);
}


// The ustar magic, 257 bytes into the header block: a match at X means a
// header may start at X - 257
proc _identify_magic
{
    magic("ustar", 257);
}

// The ustar magic sits 257 bytes into the 512 byte header block, so there has
// to be a whole block here; a header whose name field is empty is padding, not
// an entry. Five ASCII bytes would match the word wherever it appears in a
// payload, so the block's own checksum is what makes a hit mean something
proc _identify
{
    if (remaining_size() < 0x200 || peek(5, 257) != "ustar" ||
        peek_u8() == 0) {
        return;
    }

    // the stored value is octal ASCII, padded with NULs and/or spaces
    local stored = to_int(trim(printable(peek(8, 148))), 8);
    if (stored != header_checksum()) {
        return;
    }

    // one header block: the scan then lands on the next member, so every
    // entry of an archive gets reported
    result = 0x200;
}

proc
{
    while (off() + 0x200 < size()) {
        TarHeader header;
        if (strlen(header.size) == 0) {
            break;
        }
        u8    data[to_int(printable(header.size), 8)];
        // every entry is padded to the 512 bytes block size
        seek(align_up(off(), 0x200));
    }
}
