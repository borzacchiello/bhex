orenum gzip_flags_t : u8
{
    FTEXT    = 0x01,
    FHCRC    = 0x02,
    FEXTRA   = 0x04,
    FNAME    = 0x08,
    FCOMMENT = 0x10
}

enum gzip_compression_method_t : u8
{
    DEFLATE = 8
}

enum gzip_xfl_t : u8
{
    DEFAULT_COMPRESSION = 0x00,
    MAX_COMPRESSION     = 0x02,
    FASTEST_COMPRESSION = 0x04
}

enum gzip_os_t : u8
{
    FAT_FILESYSTEM  = 0,
    AMIGA           = 1,
    VMS             = 2,
    UNIX            = 3,
    VM_CMS          = 4,
    ATARI_TOS       = 5,
    HPFS_FILESYSTEM = 6,
    MACINTOSH       = 7,
    Z_SYSTEM        = 8,
    CPM             = 9,
    TOPS_20         = 10,
    NTFS_FILESYSTEM = 11,
    QDOS            = 12,
    ACORN_RISCOS    = 13,
    UNKNOWN         = 255
}

struct gzip_header_t
{
    u8                        id1;
    u8                        id2;
    gzip_compression_method_t compression_method;
    gzip_flags_t              flags;
    u32                       mtime;
    gzip_xfl_t                extra_flags;
    gzip_os_t                 os;

    if (flags & gzip_flags_t::FEXTRA) {
        u16 xlen;
        u8  extra[xlen];
    }

    if (flags & gzip_flags_t::FNAME) {
        string filename;
    }

    if (flags & gzip_flags_t::FCOMMENT) {
        string comment;
    }

    if (flags & gzip_flags_t::FHCRC) {
        u16 header_crc16;
    }
}

struct gzip_member_t
{
    gzip_header_t header;

    assert(remaining_size() >= 8, "truncated gzip member: no room for the 8 byte trailer");
    u8            compressed_data[remaining_size() - 8];
    u32           crc32;
    u32           input_size;
}


// The two magic bytes plus the only compression method ever assigned, all
// three of which "_identify" requires
proc _identify_magic
{
    magic("\x1f\x8b\x08", 0);
}

// \x1f\x8b is only two bytes and shows up constantly inside compressed data,
// so the two fields that follow it are checked as well: deflate is the only
// compression method ever assigned, and the top three flag bits are reserved
proc _identify
{
    big_endian();
    if (peek_u16() == 0x1f8b &&
        peek_u8(2) == gzip_compression_method_t::DEFLATE &&
        (peek_u8(3) & 0xe0) == 0) {
        // the length of a member is only known once it has been inflated, so
        // the hit carries the fixed part of the header and nothing more, and
        // never more of it than is actually present
        result = min(10, remaining_size());
    }
}

proc
{
    gzip_member_t member;
}
