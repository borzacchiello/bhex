{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BHE Binary Format Language",
  "scopeName": "source.bhe",
  "fileTypes": [
    "bhe"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#enum-access"
    },
    {
      "include": "#import"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#file-variables"
    },
    {
      "include": "#types"
    },
    {
      "include": "#special-variables"
    },
    {
      "include": "#member-access"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.bhe",
          "match": "//.*$"
        },
        {
          "name": "comment.block.bhe",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bhe",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.bhe"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.bhe"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.bhe",
              "match": "\\\\(?:x[0-9a-fA-F]{2}|[0rtn\\\\])"
            },
            {
              "name": "invalid.illegal.unknown-escape.bhe",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.bhe",
          "match": "\\b0[xX][0-9a-fA-F]+(?:[us](?:8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.decimal.bhe",
          "match": "\\b[0-9]+(?:[us](?:8|16|32|64))?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()([^)]*)(\\))",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.bhe"
            },
            "2": {
              "name": "entity.name.function.bhe"
            },
            "3": {
              "name": "punctuation.section.parens.begin.bhe"
            },
            "4": {
              "patterns": [
                {
                  "name": "variable.parameter.bhe",
                  "match": "[A-Za-z_][A-Za-z0-9_]*"
                }
              ]
            },
            "5": {
              "name": "punctuation.section.parens.end.bhe"
            }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.bhe"
            },
            "2": {
              "name": "entity.name.function.bhe"
            }
          }
        },
        {
          "begin": "\\b(enum|orenum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.enum.bhe"
            },
            "2": {
              "name": "entity.name.type.enum.bhe"
            },
            "3": {
              "name": "punctuation.separator.bhe"
            },
            "4": {
              "patterns": [
                {
                  "include": "#types"
                }
              ]
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.bhe"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#numbers"
            },
            {
              "name": "variable.other.enummember.bhe",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        {
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.struct.bhe"
            },
            "2": {
              "name": "entity.name.type.struct.bhe"
            }
          }
        },
        {
          "match": "\\b(proc)\\s+(_identify_magic|_identify)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.proc.bhe"
            },
            "2": {
              "name": "support.function.identify.bhe"
            }
          }
        },
        {
          "match": "\\b(proc)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.declaration.proc.bhe"
            },
            "2": {
              "name": "entity.name.function.proc.bhe"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bhe",
          "match": "\\b(?:continue|return|break|while|elif|else|if)\\b"
        },
        {
          "name": "storage.modifier.bhe",
          "match": "\\b(?:local)\\b"
        },
        {
          "name": "keyword.declaration.bhe",
          "match": "\\b(?:orenum|struct|enum|proc|fn)\\b"
        }
      ]
    },
    "enum-access": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.type.bhe"
            },
            "2": {
              "name": "punctuation.accessor.bhe"
            },
            "3": {
              "name": "variable.other.enummember.bhe"
            }
          }
        }
      ]
    },
    "import": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(#)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.namespace.bhe"
            },
            "2": {
              "name": "punctuation.accessor.bhe"
            },
            "3": {
              "name": "entity.name.type.bhe"
            }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.bhe",
          "match": "\\b(?:max_array_print|remaining_size|disable_print|little_endian|enable_print|starts_with|big_endian|scan_until|scan_while|skip_until|skip_while|find_next|printable|align_up|checksum|index_of|peek_u16|peek_u32|peek_u64|tostring|entropy|nums_in|peek_u8|warning|wstring|assert|strlen|substr|to_int|error|magic|print|exit|find|hash|peek|read|seek|size|trim|abs|bwd|crc|fwd|i16|i32|i64|max|min|off|u16|u32|u64|i8|u8)\\b(?=\\s*\\()"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.bhe",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
        }
      ]
    },
    "file-variables": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=[;\\[])",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#types"
                },
                {
                  "name": "entity.name.type.bhe",
                  "match": ".+"
                }
              ]
            },
            "2": {
              "name": "variable.other.member.bhe"
            }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.bhe",
          "match": "\\b(?:uint16_t|uint32_t|uint64_t|int16_t|int32_t|int64_t|uint8_t|wstring|int8_t|string|wchar|char|i16|i32|i64|u16|u32|u64|i8|u8)\\b"
        }
      ]
    },
    "special-variables": {
      "patterns": [
        {
          "name": "variable.language.bhe",
          "match": "\\b(?:result)\\b"
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.bhe"
            },
            "2": {
              "name": "variable.other.member.bhe"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.bhe",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.comparison.bhe",
          "match": "==|!=|<=|>=|<(?![<])|>(?![>])"
        },
        {
          "name": "keyword.operator.bitwise.bhe",
          "match": "<<|>>|&|\\||\\^"
        },
        {
          "name": "keyword.operator.arithmetic.bhe",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.bhe",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.bhe",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.bhe",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.bhe",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.bhe",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.parens.begin.bhe",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.bhe",
          "match": "\\)"
        },
        {
          "name": "punctuation.terminator.bhe",
          "match": ";"
        },
        {
          "name": "punctuation.separator.bhe",
          "match": "[,:]"
        }
      ]
    }
  }
}
