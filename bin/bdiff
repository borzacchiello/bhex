#!/bin/bash
# Copyright (c) 2022-2026, bageyelet

usage()
{
    echo "Usage:"
    echo "  bdiff <file1> <file2>"
    exit 1
}

set -euo pipefail

if (( $# != 2 )); then
    usage
    exit 1
fi

# bhex turns the colors off when it does not write to a terminal: the pager
# does interpret the escapes ("-R"), so ask for them explicitly
CLICOLOR_FORCE=1 bhex -2c "df/p/w $2" "$1" | less -R
